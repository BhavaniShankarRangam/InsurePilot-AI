# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
# Fernet key for field-level encryption (generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# --- Data ---
# SQLite is used when unset. Docker Compose sets Postgres + pgvector.
DATABASE_URL=sqlite:///./data/insurepilot.db
REDIS_URL=
CELERY_BROKER_URL=

# --- AI ---
# mock | anthropic | openai | gemini
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL_LARGE=
LLM_MODEL_SMALL=
# local | openai
EMBEDDING_PROVIDER=local

# --- Observability ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=insurepilot
LOG_LEVEL=INFO
